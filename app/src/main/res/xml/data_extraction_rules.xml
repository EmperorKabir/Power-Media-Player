<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ data-extraction rules. Allows auto-backup of stable
  user data (Room db with bookmarks / favourites / history; user
  preferences for video / audio / playback toggles), but excludes:
    - DataStore "settings" keys for cloud OAuth (drive_oauth_picked_folders,
      spotify token JSON) — tied to a device-side AccountManager / PKCE
      challenge; restoring on a new device leaves stale invalid tokens.
    - WebView caches / cookies — temporary auth state that should not
      survive to a new install.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="file" path="datastore/settings.preferences_pb"/>
        <exclude domain="file" path="app_webview/"/>
        <exclude domain="database" path="webview.db"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="file" path="datastore/settings.preferences_pb"/>
        <exclude domain="file" path="app_webview/"/>
        <exclude domain="database" path="webview.db"/>
    </device-transfer>
</data-extraction-rules>
