<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Package visibility (Android 11+): allow detection of installed
         cloud DocumentsProvider apps so the Cloud chooser can offer
         Drive / OneDrive / Dropbox buttons even when the SAF picker's
         own source drawer is unreachable on this device. -->
    <queries>
        <package android:name="com.google.android.apps.docs" />
        <package android:name="com.microsoft.skydrive" />
        <package android:name="com.dropbox.android" />
        <!-- Spotify auto-launch: when Spotify isn't running on any
             Connect device, the cloud screen wakes it via a launch
             intent so playback can start without the user having to
             leave our app. Requires explicit visibility on A11+. -->
        <package android:name="com.spotify.music" />
    </queries>

    <!-- Network streaming (HLS, DASH, RTSP) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Background playback -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Media library access (SDK 33+) -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <!-- Fallback for SDK 30-32 -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Screen brightness override -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />

    <!-- Notifications (SDK 33+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- §C12 — wake-up alarm. USE_EXACT_ALARM is auto-granted to
         alarm-clock-class apps on Android 13+; SCHEDULE_EXACT_ALARM
         is the legacy permission. USE_FULL_SCREEN_INTENT is required
         on API 34+ to display the full-screen alarm activity over the
         lockscreen; VIBRATE drives the alarm pattern. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.TURN_SCREEN_ON" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Bluetooth: list/connect to A2DP/AVRCP devices on SDK 31+.
         BLUETOOTH_CONNECT is needed to query bonded devices and read
         names; (BLUETOOTH_SCAN removed by audit: no discovery/scan code exists;
         devices in the picker. Both are runtime-prompted. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Pre-SDK-31 fallback for reading paired devices. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <application
        android:name=".PowerMediaPlayerApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PowerMediaPlayer">

        <!-- §C10 — disable the default WorkManager initialiser so our
             Configuration.Provider in PowerMediaPlayerApp can install
             the HiltWorkerFactory before any WorkRequest fires. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- Chromecast: locates CastOptionsProviderImpl on first MediaRouteButton tap -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="com.powermediaplayer.cast.CastOptionsProviderImpl" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|density"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.PowerMediaPlayer">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Handle audio/video file opens -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>

        <!-- Drive Picker WebView host. Launched via startActivityForResult
             from CloudBrowserScreen; receives an OAuth token in
             EXTRA_OAUTH_TOKEN, returns picked folder ID + name. Single-
             task so the back button cleanly returns to the cloud screen. -->
        <activity
            android:name=".cloud.DrivePickerActivity"
            android:exported="false"
            android:label="Pick a Drive folder"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|density"
            android:theme="@style/Theme.PowerMediaPlayer" />

        <!-- Tiny foreground service that gives us BAL (background
             activity launch) exemption while we auto-launch Spotify
             and bounce back to our own UI. Self-stops after 10 s. -->
        <service
            android:name=".service.SpotifyBounceService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="spotify_bounce_back" />
        </service>

        <!-- Translucent activity that owns the Spotify auto-launch and
             the deferred bounce-back. See class doc — investigation
             prototype for fix-shape (c) of the cold-start RCA at
             docs/superpowers/investigation/2026-05-05-spotify-cold-start-bounce/.
             Lives in MainActivity's task (no taskAffinity override) so
             the bounce intent has a chance of clearing Samsung One UI's
             realInVisibleTask check. -->
        <activity
            android:name=".service.SpotifyBounceBridgeActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize" />

        <!-- Media Playback Service -->
        <service
            android:name=".service.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- §C1 — Quick Settings tile for play/pause without unlock. -->
        <service
            android:name=".widget.PlaybackQuickSettingsTile"
            android:exported="true"
            android:icon="@android:drawable/ic_media_play"
            android:label="Power Media Player"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- §C3 — Tasker / external-intent control. android:exported=true
             so external automation (Tasker / Macrodroid / adb shell
             am broadcast) can reach it. Internal toggle in Settings
             gates whether the receiver acts on the incoming intent. -->
        <receiver
            android:name=".integration.TaskerReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.powermediaplayer.action.PLAY" />
                <action android:name="com.powermediaplayer.action.PAUSE" />
                <action android:name="com.powermediaplayer.action.PLAY_PAUSE" />
                <action android:name="com.powermediaplayer.action.SKIP_NEXT" />
                <action android:name="com.powermediaplayer.action.SKIP_PREV" />
                <action android:name="com.powermediaplayer.action.SKIP_BACK_30" />
                <action android:name="com.powermediaplayer.action.SKIP_FORWARD_30" />
                <action android:name="com.powermediaplayer.action.SEEK_TO" />
            </intent-filter>
        </receiver>

        <!-- §C1 follow-up — companion skip tiles. -->
        <service
            android:name=".widget.SkipBack15Tile"
            android:exported="true"
            android:icon="@android:drawable/ic_media_rew"
            android:label="PMP −15 s"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".widget.SkipForward15Tile"
            android:exported="true"
            android:icon="@android:drawable/ic_media_ff"
            android:label="PMP +15 s"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Phase 8 — home-screen now-playing widget. Foldable-
             responsive via a single layout; tap → opens the app,
             buttons fire Tasker-style broadcasts the existing
             TaskerReceiver consumes. -->
        <receiver
            android:name=".widget.NowPlayingWidgetProvider"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.powermediaplayer.widget.REFRESH" />
                <action android:name="com.powermediaplayer.widget.PLAY_PAUSE" />
                <action android:name="com.powermediaplayer.widget.PREV" />
                <action android:name="com.powermediaplayer.widget.NEXT" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_now_playing_info" />
        </receiver>

        <!-- Audit 6.12 — PiP window transport actions. exported=false:
             only our own PendingIntents target it. -->
        <receiver
            android:name=".widget.PipActionReceiver"
            android:exported="false" />

        <!-- §C12 — wake-up alarms. exported=false: only fired by the
             AlarmManager PendingIntent we own. -->
        <receiver
            android:name=".alarm.AlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.powermediaplayer.alarm.FIRE" />
            </intent-filter>
        </receiver>

        <!-- §C12 — re-schedule alarms after reboot / app update. The
             system fires BOOT_COMPLETED when the user-decryption stage
             finishes, LOCKED_BOOT_COMPLETED earlier (Direct Boot
             devices), MY_PACKAGE_REPLACED on APK upgrade. We honour
             all three so no alarm silently dies. -->
        <receiver
            android:name=".alarm.BootCompletedReceiver"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- §C12 — full-screen alarm activity. showWhenLocked + turnScreenOn
             flags are also set imperatively in the activity (they're
             newer / the manifest analogue is API 27+). -->
        <!-- configChanges parity with MainActivity + density: rotating or
             folding during a ringing alarm used to RECREATE the activity,
             restarting the volume ramp / vibration / math challenge from
             scratch (audit 6.7). -->
        <activity
            android:name=".alarm.FullScreenAlarmActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|density"
            android:theme="@style/Theme.PowerMediaPlayer" />

    </application>

</manifest>
