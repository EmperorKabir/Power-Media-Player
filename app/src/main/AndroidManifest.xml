<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Package visibility (Android 11+): allow detection of installed
         cloud DocumentsProvider apps so the Cloud chooser can offer
         Drive / OneDrive / Dropbox buttons even when the SAF picker's
         own source drawer is unreachable on this device. -->
    <queries>
        <package android:name="com.google.android.apps.docs" />
        <package android:name="com.microsoft.skydrive" />
        <package android:name="com.dropbox.android" />
        <!-- Spotify auto-launch: when Spotify isn't running on any
             Connect device, the cloud screen wakes it via a launch
             intent so playback can start without the user having to
             leave our app. Requires explicit visibility on A11+. -->
        <package android:name="com.spotify.music" />
    </queries>

    <!-- Network streaming (HLS, DASH, RTSP) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Background playback -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Media library access (SDK 33+) -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <!-- Fallback for SDK 30-32 -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Screen brightness override -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />

    <!-- Notifications (SDK 33+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Bluetooth: list/connect to A2DP/AVRCP devices on SDK 31+.
         BLUETOOTH_CONNECT is needed to query bonded devices and read
         names; BLUETOOTH_SCAN is needed to surface available unpaired
         devices in the picker. Both are runtime-prompted. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <!-- Pre-SDK-31 fallback for reading paired devices. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <application
        android:name=".PowerMediaPlayerApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PowerMediaPlayer">

        <!-- Chromecast: locates CastOptionsProviderImpl on first MediaRouteButton tap -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="com.powermediaplayer.cast.CastOptionsProviderImpl" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|screenSize"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.PowerMediaPlayer">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Handle audio/video file opens -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>

        <!-- Drive Picker WebView host. Launched via startActivityForResult
             from CloudBrowserScreen; receives an OAuth token in
             EXTRA_OAUTH_TOKEN, returns picked folder ID + name. Single-
             task so the back button cleanly returns to the cloud screen. -->
        <activity
            android:name=".cloud.DrivePickerActivity"
            android:exported="false"
            android:label="Pick a Drive folder"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize"
            android:theme="@style/Theme.PowerMediaPlayer" />

        <!-- Tiny foreground service that gives us BAL (background
             activity launch) exemption while we auto-launch Spotify
             and bounce back to our own UI. Self-stops after 10 s. -->
        <service
            android:name=".service.SpotifyBounceService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="spotify_bounce_back" />
        </service>

        <!-- Translucent activity that owns the Spotify auto-launch and
             the deferred bounce-back. See class doc — investigation
             prototype for fix-shape (c) of the cold-start RCA at
             docs/superpowers/investigation/2026-05-05-spotify-cold-start-bounce/.
             Lives in MainActivity's task (no taskAffinity override) so
             the bounce intent has a chance of clearing Samsung One UI's
             realInVisibleTask check. -->
        <activity
            android:name=".service.SpotifyBounceBridgeActivity"
            android:exported="false"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize" />

        <!-- Media Playback Service -->
        <service
            android:name=".service.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

    </application>

</manifest>
