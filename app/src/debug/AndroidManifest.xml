<!--
  DEBUG-only manifest. Android's manifest merger combines this with the main
  manifest for debug builds ONLY, so release never sees the startup provider
  and never links the DeepLogger. Installed by the android-deep-logger skill.

  App Startup auto-install: declares the androidx.startup InitializationProvider
  with DeepLoggerInitializer as metadata. No host code touched.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!-- Debug-only test hook (2026-07-19): lets adb launch the Drive
             Picker WebView directly with a token extra, so the picker's
             cookie behaviour is testable on-device without the package-bound
             OAuth step (the .test suffix is not registered at the OAuth
             console). Release manifest keeps the activity non-exported. -->
        <activity
            android:name="com.powermediaplayer.cloud.DrivePickerActivity"
            android:exported="true"
            tools:node="merge"
            tools:replace="android:exported" />

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="com.powermediaplayer.deeplog.DeepLoggerInitializer"
                android:value="androidx.startup" />
        </provider>
    </application>
</manifest>
